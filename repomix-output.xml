    btnPaymentCredito.classList.remove('text-on-surface-variant');
    btnPaymentContado.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm');
    btnPaymentContado.classList.add('text-on-surface-variant');
    creditDueDateRow.classList.remove('hidden');
