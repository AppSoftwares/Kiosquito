  const methodBtns = document.querySelectorAll('.payment-method-btn');
  methodBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      methodBtns.forEach(b => {
        b.className = 'payment-method-btn flex items-center gap-space-xs p-3 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm text-left transition-all active:scale-[0.98]';
      });
      btn.className = 'payment-method-btn flex items-center gap-space-xs p-3 rounded-xl bg-primary text-on-primary shadow-sm text-left transition-all active:scale-[0.98]';
    });
  });

  // Calculadora de Vuelto
  const totalDueUsd = 6.00;
  const exchangeRate = 36.50;
  const receivedInput = document.getElementById('received-amount-input');
  const usdChangeDisplay = document.getElementById('usd-change-display');
  const bsChangeDisplay = document.getElementById('bs-change-display');

  function updateChange() {
    const val = parseFloat(receivedInput.value) || 0;
    const diff = val - totalDueUsd;
    if (diff >= 0) {
      usdChangeDisplay.textContent = `$${diff.toFixed(2)} USD`;
      bsChangeDisplay.textContent = `${(diff * exchangeRate).toFixed(2)} Bs`;
      usdChangeDisplay.className = 'font-headline-md text-headline-md text-primary font-extrabold leading-tight';
    } else {
      const remaining = Math.abs(diff);
      usdChangeDisplay.textContent = `Faltan $${remaining.toFixed(2)}`;
      bsChangeDisplay.textContent = `Faltan ${(remaining * exchangeRate).toFixed(2)} Bs`;
      usdChangeDisplay.className = 'font-headline-md text-headline-md text-error font-extrabold leading-tight';
    }
  }

  function setCash(amount) {
    receivedInput.value = amount;
    updateChange();
  }

  function showToast(message) {
    const toast = document.getElementById('toastNotification');
    const msgEl = document.getElementById('toastMessage');
    msgEl.textContent = message;
    toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
        toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2000);
  }

  function copyExchangeRate() {
    navigator.clipboard.writeText("36.50");
    showToast("Tasa copiada: 36.50 Bs");
  }

  function showPagoMovilInfo() {
      const info = document.getElementById('pago-movil-info');
      info.classList.toggle('hidden');
  }

  function copyPagoMovil() {
      const data = "Banco: Mercantil, Telf: 04125550199, RIF: J-408192841";
      navigator.clipboard.writeText(data);
      showToast("Datos de Pago Móvil copiados");
  }

  function openFiaoModal() {
      const modal = document.getElementById('fiaoModal');
      const content = document.getElementById('fiaoModalContent');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
  }

  function closeFiaoModal() {
      const modal = document.getElementById('fiaoModal');
      const content = document.getElementById('fiaoModalContent');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      content.classList.add('scale-95');
      content.classList.remove('scale-100');
  }

  function confirmFiao() {
      closeFiaoModal();
      showToast("Venta anotada en la libreta");
      setTimeout(() => window.location.reload(), 1500);
  }

  receivedInput.addEventListener('input', updateChange);

  // Compactar / Expandir Ticket
  const toggleReceiptBtn = document.getElementById('toggle-receipt');
  const receiptPaper = document.getElementById('receipt-paper');
  let isExpanded = true;

  toggleReceiptBtn.addEventListener('click', () => {
    isExpanded = !isExpanded;
    if (!isExpanded) {
      receiptPaper.classList.add('max-h-36', 'overflow-hidden');
      toggleReceiptBtn.querySelector('span:first-child').textContent = 'Ver completo';
      toggleReceiptBtn.querySelector('.material-symbols-outlined').textContent = 'expand_more';
    } else {
      receiptPaper.classList.remove('max-h-36', 'overflow-hidden');
      toggleReceiptBtn.querySelector('span:first-child').textContent = 'Compactar';
      toggleReceiptBtn.querySelector('.material-symbols-outlined').textContent = 'expand_less';
    }
  });

  // Efecto de Cobro Exitoso Feedback
  const checkoutBtn = document.getElementById('confirm-checkout-btn');
  checkoutBtn.addEventListener('click', () => {
    const originalContent = checkoutBtn.innerHTML;
    checkoutBtn.disabled = true;
    checkoutBtn.innerHTML = `
      <div class="flex items-center justify-center gap-2 w-full">
        <span class="material-symbols-outlined animate-spin text-[22px]">progress_activity</span>
        <span class="font-label-lg text-label-lg font-bold">Imprimiendo y Cerrando Venta...</span>
      </div>
    `;
    setTimeout(() => {
      checkoutBtn.className = 'w-full h-14 bg-surface-container-high text-primary rounded-xl shadow-lg flex items-center justify-center gap-2 font-headline-sm text-headline-sm font-bold';
      checkoutBtn.innerHTML = `
        <span class="material-symbols-outlined text-[24px]">task_alt</span>
        ¡Cobro Registrado con Éxito!
      `;
    }, 1200);
  });
