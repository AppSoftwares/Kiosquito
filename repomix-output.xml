<script>
  // Control de Modo de Precio (Detalle vs Mayoreo)
  function setPriceMode(mode) {
    const btnDetalle = document.getElementById('btn-precio-detalle');
    const btnMayoreo = document.getElementById('btn-precio-mayoreo');
    
    if (mode === 'detalle') {
      btnDetalle.className = 'py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-150 flex items-center justify-center gap-1.5 bg-primary text-on-primary shadow-sm';
      btnMayoreo.className = 'py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-150 flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface';
    } else {
      btnMayoreo.className = 'py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-150 flex items-center justify-center gap-1.5 bg-secondary text-on-secondary shadow-sm';
      btnDetalle.className = 'py-2 px-3 rounded-lg font-label-md text-label-md transition-all duration-150 flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface';
    }
  }

  // Control de Modal de Clientes
  function openClientModal() {
    document.getElementById('modal-cliente').classList.remove('hidden');
    document.getElementById('input-client').focus();
  }

  function closeClientModal() {
    document.getElementById('modal-cliente').classList.add('hidden');
  }

  function selectClient(name) {
    document.getElementById('current-client-name').textContent = name;
    closeClientModal();
  }

  function saveCustomClient() {
    const val = document.getElementById('input-client').value.trim();
    if (val) {
      document.getElementById('current-client-name').textContent = val;
    }
    closeClientModal();
  }

  // Feedback Toast
  function showToast(message, icon = 'check_circle') {
    const toast = document.getElementById('toastNotification');
    const msgEl = document.getElementById('toastMessage');
    const iconEl = document.getElementById('toastIcon');
    msgEl.textContent = message;
    iconEl.textContent = icon;
    toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
        toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2000);
  }

  // Delete Confirmation
  let itemToDelete = null;
  function confirmDelete(name) {
      itemToDelete = name;
      document.getElementById('deleteItemName').textContent = name;
      const modal = document.getElementById('deleteModal');
      const content = document.getElementById('deleteModalContent');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
  }

  function closeDeleteModal() {
      const modal = document.getElementById('deleteModal');
      const content = document.getElementById('deleteModalContent');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      content.classList.add('scale-95');
      content.classList.remove('scale-100');
  }

  function executeDelete() {
      closeDeleteModal();
      showToast(`${itemToDelete} eliminado`, 'delete');
  }

  // Simulación de Balanza / Peso
  function setWeight(grams) {
    showToast(`Peso ajustado: ${grams}g`, 'scale');
  }

  // Simulación de Escáner de Barra
  function triggerBarcodeCamera() {
    const toast = document.getElementById('scanner-toast');
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 2400);
  }

  // Navegación rápida de cobro
  function goToCobro() {
    const cobroLink = document.querySelector('a[data-path="cobros-y-recibos"]');
    if (cobroLink) {
      cobroLink.click();
    } else {
      alert("Listo para procesar cobro: $6.00 / 219.00 Bs");
    }
  }
