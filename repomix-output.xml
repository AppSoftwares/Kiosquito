<script>
  // Variables de Estado en Memoria
  const TASA_CAMBIO = 36.50;
  let activeCustomerName = '';
  let activeCustomerDebtUSD = 0;
  let activeCustomerDebtBS = 0;
  let activeModalCurrency = 'USD';

  // Filtros de Lista
  const filterPills = document.querySelectorAll('.filter-pill');
  const clientCards = document.querySelectorAll('.client-card');
  const searchInput = document.getElementById('searchClientInput');

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => {
        p.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
        p.classList.add('bg-surface-container-high', 'text-on-surface-variant');
      });
      pill.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
      pill.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');

      const filterValue = pill.getAttribute('data-filter');
      applyFilters(filterValue, searchInput.value.toLowerCase().trim());
    });
  });

  searchInput.addEventListener('input', (e) => {
    const activePill = document.querySelector('.filter-pill.bg-primary');
    const filterValue = activePill ? activePill.getAttribute('data-filter') : 'all';
    applyFilters(filterValue, e.target.value.toLowerCase().trim());
  });

  function applyFilters(filter, query) {
    clientCards.forEach(card => {
      const cardStatus = card.getAttribute('data-status');
      const cardName = card.getAttribute('data-name');
      
      const matchesFilter = (filter === 'all') ||
        (filter === 'pending' && (cardStatus === 'pending' || cardStatus === 'exceeded')) ||
        (filter === 'exceeded' && cardStatus === 'exceeded') ||
        (filter === 'settled' && cardStatus === 'settled');

      const matchesQuery = !query || cardName.includes(query);

      if (matchesFilter && matchesQuery) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Apertura y Gestión del Modal de Abono
  function openAbonoModal(name, debtUSD, debtBS) {
    activeCustomerName = name;
    activeCustomerDebtUSD = debtUSD;
    activeCustomerDebtBS = debtBS;

    document.getElementById('modalClientName').textContent = name;
    document.getElementById('modalCurrentDebtUSD').textContent = `$${debtUSD.toFixed(2)}`;
    document.getElementById('modalCurrentDebtBS').textContent = `/ ${debtBS.toFixed(2)} Bs`;

    const input = document.getElementById('abonoAmountInput');
    input.value = '';
    selectModalCurrency('USD');
    updateEquivalence(0);

    const overlay = document.getElementById('abonoModalOverlay');
    const sheet = document.getElementById('abonoModalSheet');
    
    overlay.classList.remove('hidden');
    setTimeout(() => {
      sheet.classList.remove('translate-y-full');
      input.focus();
    }, 10);
  }

  function closeAbonoModal() {
    const overlay = document.getElementById('abonoModalOverlay');
    const sheet = document.getElementById('abonoModalSheet');
    sheet.classList.add('translate-y-full');
    setTimeout(() => {
      overlay.classList.add('hidden');
    }, 200);
  }

  function selectModalCurrency(currency) {
    activeModalCurrency = currency;
    const btnUSD = document.getElementById('currencyBtnUSD');
    const btnBS = document.getElementById('currencyBtnBS');
    const prefix = document.getElementById('currencyPrefix');
    const input = document.getElementById('abonoAmountInput');

    if (currency === 'USD') {
      btnUSD.className = 'py-2 rounded-lg font-label-md text-label-md font-bold text-center transition-all bg-surface-container-lowest text-primary shadow-sm';
      btnBS.className = 'py-2 rounded-lg font-label-md text-label-md font-bold text-center transition-all text-on-surface-variant';
      prefix.textContent = '$';
    } else {
      btnBS.className = 'py-2 rounded-lg font-label-md text-label-md font-bold text-center transition-all bg-surface-container-lowest text-secondary shadow-sm';
      btnUSD.className = 'py-2 rounded-lg font-label-md text-label-md font-bold text-center transition-all text-on-surface-variant';
      prefix.textContent = 'Bs';
    }
    updateEquivalence(parseFloat(input.value) || 0);
  }

  const abonoInput = document.getElementById('abonoAmountInput');
  abonoInput.addEventListener('input', (e) => {
    updateEquivalence(parseFloat(e.target.value) || 0);
  });

  function updateEquivalence(val) {
    const textEl = document.getElementById('equivalentConverted');
    const projectionEl = document.getElementById('newDebtProjected');
    let abonoUSD = 0;

    if (activeModalCurrency === 'USD') {
      abonoUSD = val;
      const converted = (val * TASA_CAMBIO).toFixed(2);
      textEl.textContent = `Equivale a: ${converted} Bs`;
    } else {
      abonoUSD = val / TASA_CAMBIO;
      const converted = (val / TASA_CAMBIO).toFixed(2);
      textEl.textContent = `Equivale a: $${converted} USD`;
    }

    const remainingUSD = Math.max(0, activeCustomerDebtUSD - abonoUSD);
    projectionEl.textContent = `Nueva deuda: $${remainingUSD.toFixed(2)}`;
  }

  function copyCollectionLink(name) {
      const link = `https://kiosquito.app/cobro/${btoa(name)}`;
      navigator.clipboard.writeText(link);
      showToast('¡Copiado! Link de estado de cuenta listo');
  }

  function setQuickAmount(amount) {
    const input = document.getElementById('abonoAmountInput');
    if (activeModalCurrency === 'USD') {
      input.value = amount.toFixed(2);
    } else {
      input.value = (amount * TASA_CAMBIO).toFixed(2);
    }
    updateEquivalence(parseFloat(input.value));
  }

  function setFullPayment() {
    const input = document.getElementById('abonoAmountInput');
    if (activeModalCurrency === 'USD') {
      input.value = activeCustomerDebtUSD.toFixed(2);
    } else {
      input.value = activeCustomerDebtBS.toFixed(2);
    }
    updateEquivalence(parseFloat(input.value));
  }

  function confirmAbono() {
    const amount = parseFloat(document.getElementById('abonoAmountInput').value);
    if (!amount || amount <= 0) {
      showToast('Por favor ingresa un monto válido', 'error');
      return;
    }

    closeAbonoModal();
    const currencyStr = activeModalCurrency === 'USD' ? `$${amount.toFixed(2)}` : `${amount.toFixed(2)} Bs`;
    showToast(`Abono de ${currencyStr} registrado para ${activeCustomerName}`);
  }

  // Simulación de Envío de WhatsApp Amable y Respetuoso
  function sendFriendlyWhatsApp(name, amountUSD, amountBS) {
    const mensaje = encodeURIComponent(`¡Hola, ${name}! Te saluda el equipo de Bodega San Antonio 🏪 Esperamos que estés muy bien. Te escribimos con mucho aprecio para recordarte que mantienes un saldo pendiente de $${amountUSD.toFixed(2)} (${amountBS.toFixed(2)} Bs) en tu libretica de confianza. Cuando gustes pasar por la bodega para abonar o conversar, eres más que bienvenido. ¡Feliz día!`);
    const dummyPhone = '584120000000';
    window.open(`https://api.whatsapp.com/send?phone=${dummyPhone}&text=${mensaje}`, '_blank');
    showToast(`Mensaje preparado para ${name} 💬`);
  }

  function viewCustomerBook(name) {
    showToast(`Cargando libreta detallada de ${name}...`);
  }

  // Notificaciones Toast
  function showToast(message, type = 'success') {
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');

    toastMsg.textContent = message;
    toastIcon.textContent = type === 'error' ? 'error' : 'check_circle';
    toastIcon.className = type === 'error' ? 'material-symbols-outlined text-error text-[18px]' : 'material-symbols-outlined text-primary-fixed text-[18px]';

    toast.classList.remove('translate-y-28', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('translate-y-28', 'opacity-0');
    }, 2800);
  }

  // Click en backdrop del modal
  document.getElementById('abonoModalOverlay').addEventListener('click', (e) => {
    if (e.target.id === 'abonoModalOverlay') {
      closeAbonoModal();
    }
  });

  // Botón Nuevo Cliente
  document.getElementById('btnOpenNewClient').addEventListener('click', () => {
    showToast('Abriendo registro de nuevo Cliente Confiable...');
  });
