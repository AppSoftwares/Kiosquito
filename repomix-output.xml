<script>
  // State management for instantaneous navigation without reloads
  let activeSection = 'main';

  function navigateToSection(targetId) {
    const sections = ['main', 'company', 'account', 'security', 'appearance', 'notifications', 'help', 'legal'];
    
    sections.forEach(id => {
      const el = document.getElementById('section-' + id);
      if (el) {
        if (id === targetId) {
          el.classList.remove('hidden');
          el.classList.add('flex');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }
      }
    });

    activeSection = targetId;
  }

  // Toast banner feedback
  function showToast(message, icon = 'check_circle') {
    const toast = document.getElementById('toastNotification');
    const toastMessage = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');

    if (!toast) return;

    toastMessage.textContent = message;
    toastIcon.textContent = icon;

    toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');

    setTimeout(() => {
      toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2800);
  }

  // Save company data
  function saveCompanyData() {
    showToast('Datos de la bodega actualizados con éxito', 'done_all');
    setTimeout(() => {
      navigateToSection('main');
    }, 1200);
  }

  // Password update
  function updatePassword() {
    const pNew = document.getElementById('pwd-new').value;
    const pConfirm = document.getElementById('pwd-confirm').value;

    if (pNew !== pConfirm) {
      showToast('Las contraseñas nuevas no coinciden', 'error');
      return;
    }

    showToast('Contraseña de caja actualizada correctamente', 'lock');
    document.getElementById('pwd-current').value = '';
    document.getElementById('pwd-new').value = '';
    document.getElementById('pwd-confirm').value = '';

    setTimeout(() => {
      navigateToSection('main');
    }, 1200);
  }

  // Password Show/Hide Toggle
  function togglePasswordVisibility(fieldId, btn) {
    const input = document.getElementById(fieldId);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  // Real Dark Mode Toggle
  function toggleDarkMode() {
    const btn = document.getElementById('darkModeToggle');
    const knob = document.getElementById('darkModeKnob');
    const icon = document.getElementById('darkIcon');
    const themeLabel = document.getElementById('currentThemeLabel');
    const htmlEl = document.documentElement;

    const isDark = htmlEl.classList.toggle('dark');
    btn.setAttribute('aria-pressed', isDark);

    if (isDark) {
      btn.classList.remove('bg-outline-variant');
      btn.classList.add('bg-primary');
      knob.classList.remove('translate-x-0.5');
      knob.classList.add('translate-x-5');
      icon.textContent = 'dark_mode';
      if (themeLabel) themeLabel.textContent = 'Oscuro • ES';
      showToast('Modo Oscuro activado');
    } else {
      btn.classList.remove('bg-primary');
      btn.classList.add('bg-outline-variant');
      knob.classList.remove('translate-x-5');
      knob.classList.add('translate-x-0.5');
      icon.textContent = 'light_mode';
      if (themeLabel) themeLabel.textContent = 'Claro • ES';
      showToast('Modo Claro activado');
    }
  }

  // Language Selector
  function setLanguage(lang) {
    const btnEs = document.getElementById('lang-btn-es');
    const btnEn = document.getElementById('lang-btn-en');
    const themeLabel = document.getElementById('currentThemeLabel');
    const iconEs = btnEs.querySelector('.material-symbols-outlined');
    const iconEn = btnEn.querySelector('.material-symbols-outlined');

    if (lang === 'es') {
      btnEs.className = "flex items-center justify-center gap-2 py-3 px-space-md rounded-2xl bg-primary text-on-primary font-label-lg text-label-lg shadow-sm transition-all";
      btnEn.className = "flex items-center justify-center gap-2 py-3 px-space-md rounded-2xl bg-surface-container-low text-on-surface font-label-lg text-label-lg hover:bg-surface-container transition-all";
      iconEs.classList.remove('opacity-0');
      iconEn.classList.add('opacity-0');
      if (themeLabel) themeLabel.textContent = 'Claro • ES';
      showToast('Idioma configurado a Español');
    } else {
      btnEn.className = "flex items-center justify-center gap-2 py-3 px-space-md rounded-2xl bg-primary text-on-primary font-label-lg text-label-lg shadow-sm transition-all";
      btnEs.className = "flex items-center justify-center gap-2 py-3 px-space-md rounded-2xl bg-surface-container-low text-on-surface font-label-lg text-label-lg hover:bg-surface-container transition-all";
      iconEn.classList.remove('opacity-0');
      iconEs.classList.add('opacity-0');
      if (themeLabel) themeLabel.textContent = 'Light • EN';
      showToast('Language switched to English');
    }
  }

  // Simple Switch micro-interaction
  function toggleSimpleSwitch(btn) {
    const isPressed = btn.getAttribute('aria-pressed') === 'true';
    const knob = btn.querySelector('span');

    if (isPressed) {
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('bg-primary');
      btn.classList.add('bg-outline-variant');
      knob.classList.remove('translate-x-5');
      knob.classList.add('translate-x-0.5');
      showToast('Ajuste desactivado');
    } else {
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.remove('bg-outline-variant');
      btn.classList.add('bg-primary');
      knob.classList.remove('translate-x-0.5');
      knob.classList.add('translate-x-5');
      showToast('Ajuste activado');
    }
  }

  // Avatar and Logo upload simulation
  const avatarInput = document.getElementById('avatarFileInput');
  if (avatarInput) {
    avatarInput.addEventListener('change', function(e) {
      if (e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          document.getElementById('avatarImageDisplay').src = evt.target.result;
          showToast('Foto de tendero actualizada', 'face');
        };
        reader.readAsDataURL(e.target.files[0]);
      }
    });
  }

  const logoInput = document.getElementById('companyLogoInput');
  if (logoInput) {
    logoInput.addEventListener('change', function(e) {
      if (e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          document.getElementById('companyLogoDisplay').src = evt.target.result;
          showToast('Logotipo de bodega actualizado', 'image');
        };
        reader.readAsDataURL(e.target.files[0]);
      }
    });
  }

  // Logout micro-interaction
  function openLogoutModal() {
    const modal = document.getElementById('logoutModal');
    const content = document.getElementById('logoutModalContent');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
    content.classList.remove('scale-95');
    content.classList.add('scale-100');
  }

  function closeLogoutModal() {
    const modal = document.getElementById('logoutModal');
    const content = document.getElementById('logoutModalContent');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.classList.remove('opacity-100');
    content.classList.add('scale-95');
    content.classList.remove('scale-100');
  }

  function confirmLogout() {
    closeLogoutModal();
    showToast('Sesión guardada y cerrada con éxito', 'lock');
  }

  function handleLogout() {
    openLogoutModal();
  }
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-4px_16px_rgba(0,0,0,0.04)]" data-active-classes="text-primary font-bold scale-105"><div class="flex items-center justify-around h-16 px-gutter-mobile"><a class="flex flex-col items-center justify-center w-16 h-12 gap-0.5 text-on-surface-variant hover:text-on-surface transition-transform duration-150" data-path="vender-pos" href="#"><span class="material-symbols-outlined text-[22px]">point_of_sale</span><span class="font-label-sm text-label-sm leading-tight text-center">POS</span></a><a class="flex flex-col items-center justify-center w-16 h-12 gap-0.5 text-on-surface-variant hover:text-on-surface transition-transform duration-150" data-path="cobros-y-recibos" href="#"><span class="material-symbols-outlined text-[22px]">receipt_long</span><span class="font-label-sm text-label-sm leading-tight text-center">Cobros</span></a><a aria-current="page" class="relative flex flex-col items-center justify-center w-16 h-12 gap-0.5 transition-transform duration-150 text-primary font-bold scale-105" data-path="clientes-confiables" href="#"><span class="material-symbols-outlined text-[22px]">handshake</span><span class="absolute top-0 right-3 w-2 h-2 rounded-full bg-secondary-container"></span><span class="font-label-sm text-label-sm leading-tight text-center">Fiao</span></a><a class="relative flex flex-col items-center justify-center w-16 h-12 gap-0.5 text-on-surface-variant hover:text-on-surface transition-transform duration-150" data-path="inventario-y-compras" href="#"><span class="material-symbols-outlined text-[22px]">inventory_2</span><span class="absolute top-0 right-3 w-2 h-2 rounded-full bg-error"></span><span class="font-label-sm text-label-sm leading-tight text-center">Stock</span></a></div></nav></body></html>
